[Unit]
Description=mis-jama.olis.ee uute päevade allalaadimine
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=mis-jama
Group=mis-jama
ExecStart=/usr/bin/python3 /usr/local/lib/mis-jama/update.py
StateDirectory=mis-jama
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/mis-jama.olis.ee
TimeoutStartSec=180

